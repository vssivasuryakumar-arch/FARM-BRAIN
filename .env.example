APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret
# Local-only SQLite. Render supplies PostgreSQL DATABASE_URL through render.yaml.
DATABASE_URL=sqlite:///farm_brain.db
# Set in Render to the exact email that should get administrator permissions.
ADMIN_EMAIL=
# Optional official Open Government Data / AGMARKNET API connector.
OGD_API_KEY=
OGD_MANDI_RESOURCE_ID=
OGD_API_BASE_URL=https://data.gov.in/api/datastore/resource.json
# Soil Health Card integration remains unavailable until the official consumer token is authorised.
SOIL_HEALTH_API_TOKEN=
COOKIE_SECURE=false
FLASK_DEBUG=false
